# Path to the directory holding the cached Garmin token file.
# Defaults to the same location the python-garminconnect example.py uses.
GARMINTOKENS=~/.garminconnect

# CORS: comma-separated origins allowed to call the API.
# Vite dev server default is http://localhost:5173.
FITSTACK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Future: Strava OAuth credentials (leave blank until you register an app).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
